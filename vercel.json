{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{ "source": "/lib/story-data/:path*", "destination": "/404.html" }],
  "functions": {
    "api/halloween-proof.js": {
      "includeFiles": "lib/story-data/halloween-monster-night.md"
    },
    "api/halloween-test-checkout.js": {
      "includeFiles": "lib/story-data/halloween-monster-night.md"
    },
    "api/convert-monster.js": {
      "maxDuration": 60,
      "includeFiles": "assets/master-references/**"
    },
    "api/convert-heic.js": {
      "maxDuration": 30
    },
    "api/lulu-sandbox-storybook-order.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
